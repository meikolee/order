<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.AccountMapper">
    <update id="updateBalance">
        UPDATE account SET balance = #{amount} WHERE user_id = #{userId}
    </update>

<!--    插入-->
    <insert id="insert">
        INSERT INTO account (user_id, balance) VALUES (#{userId}, #{balance})
    </insert>

    <select id="findBalance" resultType="java.math.BigDecimal">
         SELECT balance FROM account WHERE user_id = #{userId}
    </select>

</mapper>
