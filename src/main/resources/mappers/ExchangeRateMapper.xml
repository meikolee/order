<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.ExchangeRateMapper">
    <select id="findRate" parameterType="com.example.demo.dto.ExchangeRateParams" resultType="java.math.BigDecimal">
        SELECT rate FROM exchange_rate WHERE from_currency = #{fromCurrency} AND to_currency = #{toCurrency}
    </select>
</mapper>